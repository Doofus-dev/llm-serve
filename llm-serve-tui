#!/usr/bin/env bash
# Launch the llm-serve TUI using the project venv.
# Creates the venv and installs deps on first run (or repairs a broken one).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$SCRIPT_DIR"

# shellcheck source=lib/tui-venv.sh
source "${SCRIPT_DIR}/lib/tui-venv.sh"

if ! command -v python3 &>/dev/null; then
    echo "python3 not found. Run ./setup.sh to install Python and TUI dependencies." >&2
    exit 1
fi
if ! tui_python_version_ok; then
    echo "Python $(tui_python_version) is too old. Need Python ${TUI_MIN_PY_MAJOR}.${TUI_MIN_PY_MINOR}+." >&2
    echo "Re-run ./setup.sh after upgrading Python." >&2
    exit 1
fi
if ! tui_venv_module_ok; then
    echo "Python venv support is missing (needed to install the TUI's 'textual' module)." >&2
    echo "On Ubuntu/Debian:  sudo apt-get install python3-venv python3-pip" >&2
    echo "Or re-run ./setup.sh, which installs this for you." >&2
    exit 1
fi

if ! tui_ensure_runtime "${SCRIPT_DIR}"; then
    echo "Failed to set up the TUI Python environment." >&2
    echo "On Ubuntu/Debian make sure python3-venv is installed, then re-run ./setup.sh." >&2
    exit 1
fi

exec "$(tui_venv_dir "${SCRIPT_DIR}")/bin/python" -m tui "$@"
