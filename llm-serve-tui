#!/usr/bin/env bash
# Launch the llm-serve TUI using the project venv.
# Creates the venv and installs deps on first run.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$SCRIPT_DIR"

if [[ ! -d .venv ]]; then
    echo "First run: creating .venv and installing TUI dependencies..."
    python3 -m venv .venv
    .venv/bin/pip install --quiet -r tui/requirements.txt
fi

exec .venv/bin/python -m tui "$@"
